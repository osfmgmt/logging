{
  "compilerOptions": {
    "module": "commonjs",
    "lib": ["ESNext"],
    "target": "ES2022",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "declarationMap": true,
    "isolatedModules": true,
    "strict": true,
    "noImplicitReturns": true,
    "moduleResolution": "node",
    "removeComments": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "composite": true,
    "types": ["jest", "node"]
  },
  "exclude": [
    "node_modules",
    "**/__tests__/*"
  ]
}
